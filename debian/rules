#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Build the BPF object with the newest versioned clang present; the floor is
# 17.
CLANG := $(shell command -v clang-21 || command -v clang-20 || command -v clang-19 || command -v clang-18 || command -v clang-17 || command -v clang)

# Version for --version: the changelog version without the Debian revision.
DEB_VERSION := $(shell dpkg-parsechangelog -SVersion)
VERSION := $(shell echo '$(DEB_VERSION)' | sed 's/-[^-]*$$//')

%:
	dh $@

override_dh_auto_build:
	$(MAKE) CLANG=$(CLANG) VERSION=$(VERSION)

override_dh_auto_test:
	$(MAKE) check-host CLANG=$(CLANG)

override_dh_auto_install:
	$(MAKE) install DESTDIR=debian/xdp-bfd CLANG=$(CLANG) VERSION=$(VERSION)

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
