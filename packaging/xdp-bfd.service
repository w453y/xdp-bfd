[Unit]
Description=XDP BFD data plane
Documentation=man:xdp-bfd(8)
After=network-online.target
Wants=network-online.target
Before=frr.service

[Service]
Type=simple
EnvironmentFile=/etc/xdp-bfd/engine.conf
ExecStart=/usr/sbin/xdp-bfd $XDP_BFD_ARGS
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5
RuntimeDirectory=xdp-bfd

# Unprivileged, as a dedicated user the package creates. The capabilities
# are the ones the engine actually needs: CAP_BPF and CAP_PERFMON to load
# the XDP object, CAP_NET_ADMIN to attach it, CAP_NET_RAW for the echo
# path's AF_PACKET socket.
User=xdp-bfd
Group=xdp-bfd
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/xdp-bfd
OOMScoreAdjust=-900
LockPersonality=yes

# Detection and the heartbeat run in the userspace loop, so it has to stay
# schedulable when softirq is saturated. Raise the priority only if other
# real-time threads share the core. Headroom for busy hosts rather than a
# fix for anything observed; see security.md.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10
IOSchedulingClass=realtime
# Pin off the CPUs serving RX queues if there are spare cores. Not a default.
#CPUAffinity=

# Measured RSS is about 2 MB and does not grow per packet or per session
# (BPF maps are separate kernel memory). Keeps it off the reclaim path.
MemoryMin=8M

[Install]
WantedBy=multi-user.target
