#!/bin/bash
# Run the injection matrix before pushing. Not in CI: it needs the
# testbed.
#
# Skips rather than blocks when the testbed is not there. A hook that
# fails on an unrelated machine gets disabled, and a disabled hook catches
# nothing.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 0

pgrep -x bfd_tx >/dev/null || { echo "pre-push: no engine, skipping matrix"; exit 0; }
stats=/tmp/bfd_tx_stats.json
# The snapshot is written on SIGUSR1, so ask for one rather than reading
# whatever is lying there. An engine started without --stats-dump does not
# answer, and the file it leaves behind will claim a full mesh for days,
# so check afterwards that the file actually moved: an unknown mesh has to
# read as unknown, not as a healthy one.
sudo pkill -USR1 -x bfd_tx 2>/dev/null
sleep 1
if [ ! -f "$stats" ]; then
    echo "pre-push: no $stats, skipping matrix"; exit 0
fi
age=$(( $(date +%s) - $(stat -c %Y "$stats") ))
if [ "$age" -gt 30 ]; then
    echo "pre-push: $stats did not refresh on SIGUSR1 ($((age / 60))m old),"
    echo "pre-push: so the mesh state is unknown; skipping"
    exit 0
fi
up=$(python3 - <<'PY' 2>/dev/null
import json
try:
    print(json.load(open("/tmp/bfd_tx_stats.json"))["sessions_up"])
except Exception:
    print(0)
PY
)
[ "${up:-0}" -ge 2 ] || { echo "pre-push: mesh is down ($up up), skipping"; exit 0; }

matrix=tests/testbed/inject_matrix.py
# A missing script means one of two very different things. If the engine
# sources are not here either, this is a branch the gate does not apply
# to, such as docs, and there is nothing to check. If they are here, the
# script has moved or been deleted and the gate is broken, which must not
# pass quietly: that is exactly how the stale path below went unnoticed
# for weeks.
if [ ! -f "$matrix" ]; then
    if [ ! -d src/engine ]; then
        echo "pre-push: no engine sources here, skipping matrix"
        exit 0
    fi
    echo "pre-push: $matrix is missing; the matrix gate did not run"
    echo "pre-push: push refused (--no-verify to override)"
    exit 1
fi

echo "pre-push: running the injection matrix against $up sessions"
# stdout only: progress goes to stderr, and folding it back in with 2>&1
# breaks the parse. The script exits non-zero when cases fail, which is
# what this hook exists to catch, so the status is deliberately not
# checked here - valid JSON means the run happened and `failures` is the
# answer whatever the exit status was.
out=$(python3 "$matrix" --json)
fails=$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["failures"])')
if [ -z "$fails" ]; then
    # A hook problem, not a test failure. Say so and get out of the way.
    echo "pre-push: could not parse --json output, skipping"
    exit 0
fi
if [ "$fails" != "0" ]; then
    printf '%s' "$out" | python3 -c '
import json,sys
d = json.load(sys.stdin)
for c in d["cases"]:
    if not c["ok"]:
        print("FAIL", c["name"])
        for k in c["checks"]:
            print("   ", k["counter"], k["before"], "->", k["after"],
                  "=", k["delta"], "expected", k["expected"])
' 2>/dev/null
    echo "pre-push: $fails case(s) failed; push refused (--no-verify to override)"
    exit 1
fi
echo "pre-push: matrix clean"
exit 0
