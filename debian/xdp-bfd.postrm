#!/bin/sh
set -e

# Remove the dedicated system user on purge only (not on remove/upgrade,
# which keep it so a reinstall reuses the same uid and file ownership).
case "$1" in
    purge)
        if getent passwd xdp-bfd >/dev/null; then
            userdel xdp-bfd 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
