#!/bin/bash
# Run the injection matrix before pushing; it needs the testbed, so it is not
# in CI. Skips rather than blocks when the testbed is absent.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 0

pgrep -x bfd_tx >/dev/null || { echo "pre-push: no engine, skipping matrix"; exit 0; }
stats=/tmp/bfd_tx_stats.json
# Ask for a fresh snapshot. An engine without --stats-dump leaves a stale file,
# so check the file actually moved.
sudo pkill -USR1 -x bfd_tx 2>/dev/null
sleep 1
if [ ! -f "$stats" ]; then
    echo "pre-push: no $stats, skipping matrix"; exit 0
fi
age=$(( $(date +%s) - $(stat -c %Y "$stats") ))
if [ "$age" -gt 30 ]; then
    echo "pre-push: $stats did not refresh on SIGUSR1 ($((age / 60))m old),"
    echo "pre-push: so the mesh state is unknown; skipping"
    exit 0
fi
up=$(python3 - <<'PY' 2>/dev/null
import json
try:
    print(json.load(open("/tmp/bfd_tx_stats.json"))["sessions_up"])
except Exception:
    print(0)
PY
)
[ "${up:-0}" -ge 2 ] || { echo "pre-push: mesh is down ($up up), skipping"; exit 0; }

matrix=tests/testbed/inject_matrix.py
# No matrix script: fine on a branch without the engine, such as docs, but a
# broken gate if the engine is here.
if [ ! -f "$matrix" ]; then
    if [ ! -d src/engine ]; then
        echo "pre-push: no engine sources here, skipping matrix"
        exit 0
    fi
    echo "pre-push: $matrix is missing; the matrix gate did not run"
    echo "pre-push: push refused (--no-verify to override)"
    exit 1
fi

echo "pre-push: running the injection matrix against $up sessions"
# stdout only; progress goes to stderr. The exit status is ignored: valid JSON
# means the run happened, and `failures` is the answer.
out=$(python3 "$matrix" --json)
fails=$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["failures"])')
if [ -z "$fails" ]; then
    # A hook problem, not a test failure. Say so and get out of the way.
    echo "pre-push: could not parse --json output, skipping"
    exit 0
fi
if [ "$fails" != "0" ]; then
    printf '%s' "$out" | python3 -c '
import json,sys
d = json.load(sys.stdin)
for c in d["cases"]:
    if not c["ok"]:
        print("FAIL", c["name"])
        for k in c["checks"]:
            print("   ", k["counter"], k["before"], "->", k["after"],
                  "=", k["delta"], "expected", k["expected"])
' 2>/dev/null
    echo "pre-push: $fails case(s) failed; push refused (--no-verify to override)"
    exit 1
fi
echo "pre-push: matrix clean"
exit 0
