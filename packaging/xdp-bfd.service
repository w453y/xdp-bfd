[Unit]
Description=XDP BFD data plane
Documentation=man:xdp-bfd(8)
After=network-online.target
Wants=network-online.target
Before=frr.service

[Service]
Type=simple
EnvironmentFile=/etc/xdp-bfd/engine.conf
ExecStart=/usr/sbin/xdp-bfd $XDP_BFD_ARGS
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5
RuntimeDirectory=xdp-bfd

# Unprivileged, with only the capabilities the engine needs: CAP_BPF and
# CAP_PERFMON to load the object, CAP_NET_ADMIN to attach it, CAP_NET_RAW for
# the echo socket.
User=xdp-bfd
Group=xdp-bfd
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/xdp-bfd
OOMScoreAdjust=-900
LockPersonality=yes

# Keep the userspace loop schedulable when softirq is saturated; it runs
# detection and the heartbeat.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10
IOSchedulingClass=realtime
# Pin off the CPUs serving RX queues if there are spare cores. Not a default.
#CPUAffinity=

# RSS is about 2 MB and does not grow with packets or sessions; keeps the
# process off the reclaim path.
MemoryMin=8M

[Install]
WantedBy=multi-user.target
