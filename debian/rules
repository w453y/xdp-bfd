#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Version for --version: the changelog version without the Debian revision.
DEB_VERSION := $(shell dpkg-parsechangelog -SVersion)
VERSION := $(shell echo '$(DEB_VERSION)' | sed 's/-[^-]*$$//')

%:
	dh $@

override_dh_auto_build:
	$(MAKE) VERSION=$(VERSION)

override_dh_auto_test:
	$(MAKE) check-host

override_dh_auto_install:
	$(MAKE) install DESTDIR=debian/xdp-bfd VERSION=$(VERSION)

# postinst reloads a running engine on upgrade (after-upgrade), which a stop in
# preinst would turn into a restart the peers see.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade
